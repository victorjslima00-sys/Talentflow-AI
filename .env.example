# ==============================================================================
# TalentFlow AI — Environment Configuration Example (.env.example)
# DO NOT commit real secrets or production credentials to this file.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_NAME=TalentFlow AI
APP_VERSION=0.1.0
DEBUG=false

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# Must connect to 127.0.0.1 in local development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/talentflow_dev

# Task Queue & Cache (Redis)
REDIS_URL=redis://127.0.0.1:6379/0

# AI Provider Configuration (mock | gemini | openai)
# NOTE: The application will fail to start if APP_ENV=production and LLM_PROVIDER=mock
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Binding
HOST=127.0.0.1
PORT=8000
